{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cas13guide",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "cas13guide",
        "serve",
        "--port",
        "8765",
        "--no-browser"
      ],
      "port": 8765
    },
    {
      "name": "docs-site",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--directory",
        "docs"
      ],
      "port": 8766
    }
  ]
}
